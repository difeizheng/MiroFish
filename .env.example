# LLM API配置（支持 OpenAI SDK 格式的任意 LLM API）
# 推荐使用阿里百炼平台qwen-plus模型：https://bailian.console.aliyun.com/
# 注意消耗较大，可先进行小于40轮的模拟尝试
LLM_API_KEY=your_api_key_here
LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_MODEL_NAME=qwen-plus

# ===== ZEP记忆图谱配置 =====
# 每月免费额度即可支撑简单使用：https://app.getzep.com/
ZEP_API_KEY=your_zep_api_key_here

# ===== Graphiti 后端配置（可选，替换 Zep Cloud）=====
# GRAPH_BACKEND=zep（默认，走 Zep Cloud）或 graphiti（走本地 Neo4j）
# GRAPH_BACKEND=graphiti
# NEO4J_URI=bolt://neo4j:7687
# NEO4J_USER=neo4j
# NEO4J_PASSWORD=testpass
# NEO4J_DATABASE=neo4j

# ===== Graphiti 写路径 LLM 配置（可选）=====
# 仅 GRAPH_BACKEND=graphiti 时生效。
# 抽取 LLM：用于 graphiti.add_episode 从文本抽取实体/关系
# Embedder：用于图谱节点向量化（搜索用）
# 两者都支持任意 OpenAI 兼容 API（/chat/completions + /embeddings）
# 不配置时写路径自动降级为本地 JSONL（读路径仍走 Neo4j）
# EXTRACTION_API_KEY=your_extraction_api_key_here
# EXTRACTION_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# EXTRACTION_MODEL_NAME=qwen-plus
# EMBED_API_KEY=your_embed_api_key_here
# EMBED_BASE_URL=https://api.minimaxi.com/v1
# EMBED_MODEL_NAME=embo-01

# ===== 加速 LLM 配置（可选）=====
# 注意如果不使用加速配置，env文件中就不要出现下面的配置项
LLM_BOOST_API_KEY=your_api_key_here
LLM_BOOST_BASE_URL=your_base_url_here
LLM_BOOST_MODEL_NAME=your_model_name_here
